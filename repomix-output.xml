            if (upower != null) {
                power_dev = upower.get_primary_device();
                if (power_dev != null) {
                    update_status();
                    power_dev.notify["percentage"].connect(update_status);
                    power_dev.notify["state"].connect(update_status);
                }
            }
        }

        private void update_status() {
            if (power_dev == null) return;
            if (!power_dev.present) {
