}

#notifications-list .notification-widget-media-button:hover {
    background: @success;
}

/*
 * Notification Group
 */

#notifications-list .notification-group-list-header {
    border-radius: 10px;
    margin-top: 20px;
}

#notifications-list .notification-group-app-name {
    padding: 4px;
    margin: 4px;
