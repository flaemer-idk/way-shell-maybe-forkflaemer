#include "way-shell-wp-helpers.h"

void way_shell_wp_set_volume (GObject *mixer_api, guint32 id, double volume) {
    if (!mixer_api) return;
    gboolean success = FALSE;
    // В чистом Си компилятор GCC/Clang гарантирует безупречное выравнивание типов вариативных аргументов
    g_signal_emit_by_name (mixer_api, "set-volume", id, volume, &success);
}

void way_shell_wp_set_mute (GObject *mixer_api, guint32 id, gboolean mute) {
    if (!mixer_api) return;
    gboolean success = FALSE;
    g_signal_emit_by_name (mixer_api, "set-mute", id, mute, &success);
}
