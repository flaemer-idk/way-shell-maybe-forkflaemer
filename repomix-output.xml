using GLib;

public static int main(string[] args) {
    if (args.length < 2) {
        stdout.printf("Usage: way-sh <command>\nExamples:\n");
        stdout.printf("  way-sh message-tray-open\n");
        stdout.printf("  way-sh volume-up\n");
        stdout.printf("  way-sh volume-down\n");
        stdout.printf("  way-sh brightness-up\n");
        stdout.printf("  way-sh brightness-down\n");
        return 1;
    }

    // Собираем аргументы через дефис (например, "volume", "up" -> "volume-up")
    string cmd = "";
    for (int i = 1; i < args.length; i++) {
        if (i > 1) cmd += "-";
        cmd += args[i];
    }

    string? runtime_dir = Environment.get_variable("XDG_RUNTIME_DIR");
    if (runtime_dir == null) {
        stderr.printf("Error: XDG_RUNTIME_DIR is not set\n");
        return 1;
    }

    string sock_path = Path.build_filename(runtime_dir, "way-shell.sock");
    try {
        var client = new SocketClient();
        var address = new UnixSocketAddress(sock_path);
        var conn = client.connect(address);
        
        var output = new DataOutputStream(conn.output_stream);
        output.put_string(cmd + "\n");
        
        var input = new DataInputStream(conn.input_stream);
        string? response = input.read_line();
        if (response != null && response.strip() == "true") {
            return 0;
        }
    } catch (Error e) {
        stderr.printf("Error connecting to way-shell: %s\n", e.message);
        return 1;
    }
    return 1;
}
