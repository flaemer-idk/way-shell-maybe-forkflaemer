<file path="contrib/systemd/way-shell.service">
[Unit]
Description=Runs way-shell once sway session target is reached

[Service]
Type=Exec
# This is required when Way-Shell runs under systemd.
#
# Way-Shell launches other apps and these apps join the same control group,
# even if a forked (daemonized) launch is performed.
#
# This directive tells systemd to only kill the main process when Way-Shell is
# restarted or crashes, avoiding the killing of any launched apps.
KillMode=process
ExecStart=/usr/bin/way-shell

[Install]
WantedBy=sway-session.target
</file>

<file path="contrib/toolbox/fedora/Dockerfile">
FROM quay.io/toolbx-images/fedora-toolbox:40

RUN sudo dnf install -y \
    libadwaita-devel \
    upower-devel \
    wireplumber-devel \
    json-glib-devel \
    NetworkManager-libnm-devel \
    pulseaudio-libs-devel \
    meson \
    cmake \
    gtk-doc

# build and install gtk4-layer-shell v1.0.1
RUN cd /tmp && \
    curl -LO https://github.com/wmww/gtk4-layer-shell/archive/refs/tags/v1.0.2.tar.gz && \
    tar -xvf v1.0.2.tar.gz && cd gtk4-layer-shell-1.0.2  && \
    meson setup --prefix=/usr -Dexamples=true -Ddocs=true -Dtests=true build && \
    ninja -C build/ && \
    ninja -C build/ install && \
    rm -rf /tmp/v1.0.2.tar.gz \
    rm -rf gtk4-layer-shell-1.0.2

# clone and build way-shell and way-sh
RUN mkdir /src && \
    cd /src && \
    git clone https://github.com/ldelossa/way-shell.git && \
    cd way-shell && \
    git submodule init && git submodule update && \
    make && \
    make gschema && \
    cp way-shell /usr/local/bin/ && \
    cp way-sh/way-sh /usr/local/bin && \
    rm -rf /src

CMD ["/usr/local/bin/way-shell"]
</file>

<file path="contrib/toolbox/fedora/Makefile">
all: build create run

.PHONY:
build:
	podman build -t way-shell:latest .

.PHONY:
create:
	toolbox create --image way-shell:latest way-shell

.PHONY:
run:
	toolbox run --container way-shell way-shell
</file>

